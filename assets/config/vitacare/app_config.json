      "icon": "watch",
      "transports": ["ble"],
      "readings": [
        { "key": "hr", "label": "Heart rate", "shortLabel": "HR", "unit": "bpm", "icon": "pulse", "normal": [60, 100], "scale": [40, 160] },
        { "key": "spo2", "label": "SpO₂", "unit": "%", "icon": "drop", "normal": [95, 100], "scale": [80, 100] },
        { "key": "bp", "label": "Blood pressure", "unit": "mmHg", "icon": "heart", "normal": [90, 120], "scale": [80, 180], "pair": "bp_dia" },
        { "key": "bp_dia", "label": "Diastolic pressure", "unit": "mmHg", "icon": "heart" },
        { "key": "temp", "label": "Skin temp", "unit": "°C", "icon": "thermo", "decimals": 1, "normal": [36.1, 37.2], "scale": [34, 40] },
        { "key": "steps", "label": "Steps", "unit": "today", "icon": "trend", "goal": 10000 },
        { "key": "sleep", "label": "Sleep", "unit": "last night", "icon": "moon", "decimals": 1, "goal": 8, "format": "hoursMinutes" },
        { "key": "resp", "label": "Respiration", "unit": "br/min", "icon": "wind", "normal": [12, 20], "scale": [8, 30] }
      ],
      "alerts": [{ "key": "hr", "above": 110 }, { "key": "spo2", "below": 92 }, { "key": "battery", "below": 15 }],
