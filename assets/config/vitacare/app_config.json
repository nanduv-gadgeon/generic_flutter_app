{
  "isCloud": false,
  "brand": {
    "appName": "VitaCare",
    "logoMark": "assets/brand/vitacare/logo_mark.svg",
    "logoSplash": "assets/brand/vitacare/logo_splash.svg",
    "initials": "V",
    "tagline": "Care that stays connected"
  },
  "theme": {
    "primary": "#0F766E",
    "accent": "#2DD4BF",
    "font": "Nunito",
    "cornerRadius": 22,
    "cornerRadiusSmall": 16,
    "mode": "system"
  },
  "features": { "registration": true, "faceIdLogin": true, "history": true, "export": true, "alerts": true },
  "links": {
    "privacyPolicy": "https://example.com/privacy",
    "termsOfUse": "https://example.com/terms"
  },
  "links": {
    "privacyPolicy": "https://example.com/privacy",
    "termsOfUse": "https://example.com/terms"
  },
  "history": { "daysOnPhone": 7 },
  "cloud": { "baseUrl": "https://api.example", "environment": "dev", "uploader": "flutterModule", "autoSyncDefault": "15m" },
  "deviceTypes": ["smart_band_v1", "env_sensor_v1", "wearable_patch_v1", "health_kit_v1", "ief_device_v1", "ppg_motion_v1"],
  "deviceProfiles": [
    {
      "id": "smart_band_v1",
      "label": "Smart band",
      "summary": "Heart rate, SpO₂, BP, steps, sleep",
      "icon": "watch",
      "transports": ["ble"],
      "readings": [
        { "key": "hr", "label": "Heart rate", "unit": "bpm", "icon": "pulse", "normal": [60, 100] },
        { "key": "spo2", "label": "SpO₂", "unit": "%", "icon": "drop", "normal": [95, 100] },
        { "key": "bp", "label": "Blood pressure", "unit": "mmHg", "icon": "heart", "normal": [90, 120] },
        { "key": "temp", "label": "Skin temp", "unit": "°C", "icon": "thermo", "decimals": 1, "normal": [36.1, 37.2] },
        { "key": "steps", "label": "Steps", "unit": "steps", "icon": "trend", "goal": 10000 },
        { "key": "sleep", "label": "Sleep", "unit": "h", "icon": "moon", "decimals": 1, "goal": 8 },
        { "key": "resp", "label": "Respiration", "unit": "br/min", "icon": "wind", "normal": [12, 20] }
      ],
      "alerts": [{ "key": "hr", "above": 110 }, { "key": "spo2", "below": 92 }, { "key": "battery", "below": 15 }]
    },
    {
      "id": "env_sensor_v1",
      "label": "Environment sensor",
      "summary": "Temperature, humidity, CO₂, PM2.5",
      "icon": "chip",
      "transports": ["wifi", "ble"],
      "readings": [
        { "key": "temp", "label": "Temperature", "unit": "°C", "icon": "thermo", "decimals": 1, "normal": [20, 26] },
        { "key": "co2", "label": "CO₂", "unit": "ppm", "icon": "cloud", "normal": [400, 1000] },
        { "key": "hum", "label": "Humidity", "unit": "%", "icon": "drop", "normal": [40, 60] },
        { "key": "pm25", "label": "PM2.5", "unit": "µg/m³", "icon": "dots", "normal": [0, 15] },
        { "key": "press", "label": "Pressure", "unit": "hPa", "icon": "gauge", "normal": [1000, 1025] },
        { "key": "light", "label": "Light", "unit": "lux", "icon": "sun", "normal": [300, 500] },
        { "key": "tvoc", "label": "TVOC", "unit": "mg/m³", "icon": "flask", "decimals": 2, "normal": [0, 0.3] }
      ],
      "alerts": [{ "key": "temp", "above": 30 }, { "key": "co2", "above": 1000 }, { "key": "battery", "below": 15 }]
    },
    {
      "id": "wearable_patch_v1",
      "label": "Wearable patch",
      "summary": "Continuous heart rate, skin temp, breathing",
      "icon": "patch",
      "transports": ["ble"],
      "readings": [
        { "key": "hr", "label": "Heart rate", "unit": "bpm", "icon": "pulse", "normal": [60, 100] },
        { "key": "temp", "label": "Skin temp", "unit": "°C", "icon": "thermo", "decimals": 1, "normal": [36.1, 37.2] },
        { "key": "resp", "label": "Respiration", "unit": "br/min", "icon": "wind", "normal": [12, 20] },
        { "key": "hrv", "label": "HRV", "unit": "ms", "icon": "trend", "normal": [20, 70] },
        { "key": "active", "label": "Active time", "unit": "min", "icon": "bolt", "goal": 150 }
      ],
      "alerts": [{ "key": "hr", "above": 120 }, { "key": "temp", "above": 37.8 }, { "key": "battery", "below": 15 }]
    },
    {
      "id": "health_kit_v1",
      "label": "Health kit",
      "summary": "BP monitor, glucometer, scale, oximeter",
      "icon": "kit",
      "transports": ["ble"],
      "readings": [
        { "key": "bp", "label": "Blood pressure", "unit": "mmHg", "icon": "heart", "normal": [90, 120] },
        { "key": "glucose", "label": "Glucose", "unit": "mg/dL", "icon": "drop", "normal": [70, 140] },
        { "key": "weight", "label": "Weight", "unit": "kg", "icon": "scale", "decimals": 1, "normal": [60, 80] },
        { "key": "spo2", "label": "SpO₂", "unit": "%", "icon": "drop", "normal": [95, 100] },
        { "key": "pulse", "label": "Pulse", "unit": "bpm", "icon": "pulse", "normal": [60, 100] }
      ],
      "alerts": [{ "key": "bp", "above": 130 }, { "key": "glucose", "above": 180 }, { "key": "battery", "below": 15 }]
    },
    {
      "id": "ief_device_v1",
      "label": "IEF wearable patch",
      "summary": "Current, battery",
      "icon": "patch",
      "transports": ["ble"],
      "readings": [{ "key": "current", "label": "Current", "unit": "mA", "icon": "bolt", "decimals": 2 }],
      "alerts": [{ "key": "battery", "below": 15 }],
      "ble": {
        "serviceUuid": "1257dd10-6f99-498f-b4a6-04dc1e3591f6",
        "writeUuid": "1257dd11-6f99-498f-b4a6-04dc1e3591f6",
        "notifyUuid": "1257dd12-6f99-498f-b4a6-04dc1e3591f6",
        "scanServiceUuid": "00001257-dd10-6f99-498f-b4a604dc91f6",
        "bond": true,
        "batteryService": true
      },
      "packet": {
        "byteOrder": "little",
        "frames": [
          {
            "code": "90",
            "kind": "data",
            "minLength": 6,
            "checksum": {
              "type": "crc32",
              "storedAt": -4,
              "accept": [
                { "from": 2, "to": -4, "byteOrder": "little" },
                { "from": 0, "to": -4, "byteOrder": "little" },
                { "from": 2, "to": -4, "byteOrder": "big" }
              ]
            },
            "records": { "start": 2, "end": -4, "size": 12 },
            "time": { "offset": 0, "type": "uint64", "unit": "s" },
            "fields": [
              { "key": "battery", "offset": 9, "type": "uint8" },
              { "key": "current", "offset": 10, "type": "uint8", "when": { "offset": 8, "equals": "03" } },
              { "key": "current", "offset": 11, "type": "uint8", "scale": 0.01, "when": { "offset": 8, "equals": "03" } }
            ],
            "events": {
              "typeOffset": 8,
              "codeOffset": 10,
              "dataTypes": ["03"],
              "types": { "01": "start", "02": "stop", "04": "error" }
            }
          },
          { "code": "91", "kind": "batchEnd" },
          { "code": "92", "kind": "noData" }
        ]
      },
      "commands": [{ "id": "request_logs", "bytes": "82 00" }]
    },
    {
      "id": "ppg_motion_v1",
      "label": "PPG + Motion sensor",
      "summary": "SpO₂, heart rate, perfusion",
      "icon": "chip",
      "transports": ["ble"],
      "readings": [
        { "key": "heart_rate", "label": "Heart rate", "unit": "bpm", "icon": "heart" },
        { "key": "spo2", "label": "Blood oxygen", "unit": "%", "icon": "drop" },
        { "key": "pi_red", "label": "PI (Red)", "unit": "%", "icon": "pulse", "decimals": 2 },
        { "key": "pi_ir", "label": "PI (IR)", "unit": "%", "icon": "pulse", "decimals": 2 }
      ],
      "alerts": [{ "key": "spo2", "below": 92 }, { "key": "heart_rate", "above": 120 }, { "key": "battery", "below": 15 }],
      "ble": {
        "serviceUuid": "90bd6462-59c3-47ed-bbf8-745bfb95e91f",
        "notifyUuid": "90bd6463-59c3-47ed-bbf8-745bfb95e91f",
        "writeUuid": "90bd6465-59c3-47ed-bbf8-745bfb95e91f",
        "replyUuid": "90bd6466-59c3-47ed-bbf8-745bfb95e91f",
        "timeSync": {
          "uuid": "90bd6468-59c3-47ed-bbf8-745bfb95e91f",
          "fields": ["year16le", "month", "day", "hour", "minute", "second", "millis16le"]
        },
        "bond": false,
        "batteryService": true,
        "batteryPollSeconds": 60
      },
      "packet": {
        "byteOrder": "big",
        "frames": [
          {
            "kind": "data",
            "source": "data",
            "minLength": 11,
            "channels": {
              "maskOffset": 0,
              "start": 10,
              "type": "uint32",
              "intervalMs": 10,
              "validBelow": 1048576,
              "clampAbove": 500000,
              "keys": { "1": "ppg_red", "5": "ppg_ir" }
            }
          },
          { "code": "5A", "kind": "reply", "source": "reply", "minLength": 4, "reply": { "idOffset": 3, "dataOffset": 4 } }
        ]
      },
      "commands": [
        { "id": "stop", "bytes": "A5 A5 02 20 02", "reply": { "id": "20", "ok": "02" } },
        { "id": "set_channels", "bytes": "A5 A5 02 11 11", "reply": { "id": "11", "ok": "11" } },
        { "id": "start", "bytes": "A5 A5 02 20 01", "reply": { "id": "20", "ok": "01" } },
        { "id": "led_red", "bytes": "A5 A5 02 0A", "reply": { "id": "0A" }, "takesValue": true },
        { "id": "led_ir", "bytes": "A5 A5 02 0E", "reply": { "id": "0E" }, "takesValue": true }
      ],
      "streaming": {
        "start": ["stop", "set_channels", "start"],
        "stop": ["stop"],
        "replyTimeoutMs": 2500,
        "retries": 1,
        "problems": [
          { "id": "20", "data": "03", "problem": "sensorError" },
          { "id": "20", "data": "04", "problem": "lowBattery" },
          { "id": "20", "data": "05", "problem": "charging" },
          { "id": "CE", "data": "F4", "problem": "transferError" }
        ]
      },
      "signal": {
        "ppgOximetry": {
          "sampleRateHz": 100,
          "red": "ppg_red",
          "ir": "ppg_ir",
          "bandPass": [
            [3.12389769e-5, 6.24779538e-5, 3.12389769e-5, 1, -1.78117614, 0.799052904],
            [1, 2, 1, 1, -1.87122641, 0.903155206],
            [1, -2, 1, 1, -1.93370793, 0.935416627],
            [1, -2, 1, 1, -1.98111591, 0.982149019]
          ],
          "lowPass": [[2.46193005e-6, 4.92386009e-6, 2.46193005e-6, 1, -1.99555712, 0.995566972]],
          "window": 100,
          "emitEvery": 100,
          "spo2": { "key": "spo2", "coefficients": [1.6, -35, 113], "min": 60, "max": 110, "average": 8 },
          "heartRate": {
            "key": "heart_rate",
            "buffer": 600,
            "window": 500,
            "step": 100,
            "neighbours": 3,
            "min": 40,
            "max": 120,
            "average": 8
          },
          "perfusion": { "red": "pi_red", "ir": "pi_ir" }
        }
      },
      "agc": {
        "input": "ppg_ir",
        "smoothing": 12,
        "high": 355200,
        "low": 222000,
        "noContact": 90000,
        "holdMs": 1500,
        "cooldownMs": 1200,
        "start": 5,
        "min": 0,
        "max": 32,
        "step": 1,
        "commands": ["led_ir", "led_red"]
      }
    }
  ]
}
