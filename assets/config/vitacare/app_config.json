        "serviceUuid": "90bd6462-59c3-47ed-bbf8-745bfb95e91f",
        "notifyUuid": "90bd6463-59c3-47ed-bbf8-745bfb95e91f",
        "writeUuid": "90bd6465-59c3-47ed-bbf8-745bfb95e91f",
        "replyUuid": "90bd6466-59c3-47ed-bbf8-745bfb95e91f",
        "writeWithoutResponse": true,
        "timeSync": {
          "uuid": "90bd6468-59c3-47ed-bbf8-745bfb95e91f",
          "fields": ["year16le", "month", "day", "hour", "minute", "second", "millis16le"]
        },
        "bond": true,
        "batteryService": true,
        "batteryPollSeconds": 60
      },
      "packet": {
        "byteOrder": "big",
        "frames": [
          {
            "kind": "data",
            "source": "data",
            "minLength": 11,
            "channels": {
              "maskOffset": 0,
              "start": 10,
              "type": "uint32",
              "intervalMs": 10,
              "validBelow": 1048576,
              "clampAbove": 500000,
              "keys": { "1": "ppg_red", "5": "ppg_ir" }
            }
          },
          { "code": "5A", "kind": "reply", "source": "reply", "minLength": 4, "reply": { "idOffset": 3, "dataOffset": 4 } }
        ]
      },
      "commands": [
        { "id": "stop", "bytes": "A5 A5 02 20 02", "reply": { "id": "20", "ok": "02" } },
        { "id": "set_channels", "bytes": "A5 A5 02 11 11", "reply": { "id": "11", "ok": "11" } },
        { "id": "start", "bytes": "A5 A5 02 20 01", "reply": { "id": "20", "ok": "01" } },
        { "id": "led_red", "bytes": "A5 A5 02 0A", "reply": { "id": "0A" }, "takesValue": true },
        { "id": "led_ir", "bytes": "A5 A5 02 0E", "reply": { "id": "0E" }, "takesValue": true }
      ],
      "streaming": {
        "start": ["stop", "set_channels", "start"],
        "stop": ["stop"],
        "replyTimeoutMs": 2500,
        "retries": 1,
        "problems": [
          { "id": "20", "data": "03", "problem": "sensorError" },
          { "id": "20", "data": "04", "problem": "lowBattery" },
          { "id": "20", "data": "05", "problem": "charging" },
          { "id": "CE", "data": "F4", "problem": "transferError" }
        ]
      },
      "signal": {
        "ppgOximetry": {
          "sampleRateHz": 100,
          "red": "ppg_red",
          "ir": "ppg_ir",
          "bandPass": [
            [3.12389769e-5, 6.24779538e-5, 3.12389769e-5, 1, -1.78117614, 0.799052904],
            [1, 2, 1, 1, -1.87122641, 0.903155206],
            [1, -2, 1, 1, -1.93370793, 0.935416627],
            [1, -2, 1, 1, -1.98111591, 0.982149019]
          ],
          "lowPass": [[2.46193005e-6, 4.92386009e-6, 2.46193005e-6, 1, -1.99555712, 0.995566972]],
          "window": 100,
          "emitEvery": 100,
