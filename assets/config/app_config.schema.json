{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer app config",
  "description": "One app_config.json per customer. Holds no secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["isCloud", "brand", "theme", "features", "links", "history", "deviceTypes", "deviceProfiles"],
  "properties": {
    "isCloud": { "type": "boolean" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appName", "logoMark", "logoSplash", "initials"],
      "properties": {
        "appName": { "type": "string", "minLength": 1 },
        "logoMark": { "$ref": "#/definitions/brandAsset" },
        "logoSplash": { "$ref": "#/definitions/brandAsset" },
        "initials": { "type": "string", "minLength": 1, "maxLength": 2 },
        "tagline": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "font", "cornerRadius", "cornerRadiusSmall", "mode"],
      "properties": {
        "primary": { "$ref": "#/definitions/hexColor" },
        "accent": { "$ref": "#/definitions/hexColor" },
        "font": { "type": "string", "minLength": 1 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 40 },
        "cornerRadiusSmall": { "type": "number", "minimum": 0, "maximum": 40 },
        "mode": { "enum": ["light", "dark", "system"] }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registration", "faceIdLogin", "history", "export", "alerts"],
      "properties": {
        "registration": { "type": "boolean" },
        "faceIdLogin": { "type": "boolean" },
        "history": { "type": "boolean" },
        "export": { "type": "boolean" },
        "alerts": { "type": "boolean" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacyPolicy", "termsOfUse"],
      "properties": {
        "privacyPolicy": { "$ref": "#/definitions/httpsUrl" },
        "termsOfUse": { "$ref": "#/definitions/httpsUrl" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daysOnPhone"],
      "properties": { "daysOnPhone": { "type": "integer", "minimum": 1, "maximum": 7 } }
    },
    "cloud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "environment", "uploader", "autoSyncDefault"],
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https://" },
        "environment": { "enum": ["dev", "staging", "prod"] },
        "uploader": { "enum": ["cppLibrary", "flutterModule"] },
        "autoSyncDefault": { "enum": ["15m", "30m", "45m", "1h", "2h", "4h", "5h", "8h", "24h"] }
      }
    },
    "deviceTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "deviceProfiles": { "type": "array", "items": { "$ref": "#/definitions/deviceProfile" } }
  },
  "if": {
    "properties": { "isCloud": { "const": true } }
  },
  "then": { "required": ["cloud"] },
  "definitions": {
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "brandAsset": { "type": "string", "pattern": "^assets/brand/[a-z0-9_]+/[a-z0-9_]+\\.(svg|png)$" },
    "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "deviceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "summary", "icon", "transports", "readings", "alerts"],
      "properties": {
        "id": { "$ref": "#/definitions/key" },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "icon": { "enum": ["watch", "chip", "patch", "kit", "bolt", "thermo", "ecg", "hub", "heart"] },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ble", "wifi"] }
        },
        "readings": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/reading" } },
        "alerts": { "type": "array", "items": { "$ref": "#/definitions/alertRule" } },
        "quickReadings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/key" }
        },
        "ble": { "$ref": "#/definitions/bleSettings" },
        "packet": { "$ref": "#/definitions/packet" },
        "wifi": { "$ref": "#/definitions/wifiSettings" },
        "commands": { "type": "array", "items": { "$ref": "#/definitions/deviceCommand" } },
        "streaming": { "$ref": "#/definitions/streaming" },
        "sync": { "$ref": "#/definitions/sync" },
        "signal": { "$ref": "#/definitions/signal" },
        "agc": { "$ref": "#/definitions/agc" },
        "heartbeat": { "$ref": "#/definitions/heartbeat" },
        "dashboard": { "$ref": "#/definitions/dashboard" }
      }
    },
    "statusKind": { "enum": ["ok", "warn", "danger"] },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strip": { "enum": ["heartbeat", "state", "lastReading", "streamRate", "channels"] },
        "onDemand": { "type": "boolean" },
        "views": { "type": "array", "items": { "$ref": "#/definitions/dashboardView" } },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "command": { "$ref": "#/definitions/key" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command"],
                "properties": {
                  "command": { "$ref": "#/definitions/key" },
                  "value": { "type": "integer", "minimum": 0, "maximum": 255 },
                  "waitMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
                }
              }
            },
            "done": { "type": "string", "minLength": 1 }
          },
          "not": { "required": ["command", "steps"] }
        }
      }
    },
    "dashboardView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["gauge", "tiles", "spotValue", "note", "readingList", "waveform"] },
        "reading": { "$ref": "#/definitions/key" },
        "readings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/key" } },
        "title": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "scaleLabel": { "type": "string", "minLength": 1 },
        "sampleHz": { "type": "integer", "minimum": 1 },
        "seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "status": { "$ref": "#/definitions/key" },
        "stats": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/key" } }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{4}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$"
    },
    "hexByte": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}$" },
    "hexBytes": { "type": "string", "pattern": "^[0-9A-Fa-f]{2}( [0-9A-Fa-f]{2})*$" },
    "byteOrder": { "enum": ["little", "big"] },
    "fieldType": { "enum": ["uint8", "uint16", "uint32", "uint64", "int8", "int16", "int32", "float32"] },
    "deviceCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bytes"],
      "properties": {
        "id": { "$ref": "#/definitions/key" },
        "bytes": { "$ref": "#/definitions/hexBytes" },
        "reply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "$ref": "#/definitions/hexByte" }, "ok": { "$ref": "#/definitions/hexByte" } }
        },
        "takesValue": { "type": "boolean" },
        "time": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/timeField" } }
      }
    },
    "timeField": {
      "enum": ["year16le", "month", "day", "hour", "minute", "second", "millis16le", "year2", "hour12", "pm", "weekdayMon1", "zero"]
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 5 },
        "offlineAfterMissed": { "type": "integer", "minimum": 1 },
        "setInterval": { "$ref": "#/definitions/key" }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onConnect"],
      "properties": {
        "onConnect": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/key" } },
        "idleTimeoutMs": { "type": "integer", "minimum": 1000 },
        "everySeconds": { "type": "integer", "minimum": 10 },
        "repeat": { "type": "array", "items": { "$ref": "#/definitions/key" } }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/key" } },
        "stop": { "type": "array", "items": { "$ref": "#/definitions/key" } },
        "replyTimeoutMs": { "type": "integer", "minimum": 100 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "data", "problem"],
            "properties": {
              "id": { "$ref": "#/definitions/hexByte" },
              "data": { "$ref": "#/definitions/hexByte" },
              "problem": { "enum": ["lowBattery", "charging", "sensorError", "transferError"] }
            }
          }
        }
      }
    },
    "sosSections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ppgOximetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sampleRateHz", "red", "ir", "bandPass", "lowPass", "window", "emitEvery", "spo2", "heartRate", "perfusion"],
          "properties": {
            "sampleRateHz": { "type": "number", "exclusiveMinimum": 0 },
            "red": { "$ref": "#/definitions/key" },
            "ir": { "$ref": "#/definitions/key" },
            "bandPass": { "$ref": "#/definitions/sosSections" },
            "lowPass": { "$ref": "#/definitions/sosSections" },
            "window": { "type": "integer", "minimum": 2 },
            "emitEvery": { "type": "integer", "minimum": 1 },
            "spo2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "coefficients", "min", "max", "average"],
              "properties": {
                "key": { "$ref": "#/definitions/key" },
                "coefficients": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "min": { "type": "integer" },
                "max": { "type": "integer" },
                "average": { "type": "integer", "minimum": 1 }
              }
            },
            "heartRate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "buffer", "window", "step", "neighbours", "min", "max", "average"],
              "properties": {
                "key": { "$ref": "#/definitions/key" },
                "buffer": { "type": "integer", "minimum": 1 },
                "window": { "type": "integer", "minimum": 10 },
                "step": { "type": "integer", "minimum": 1 },
                "neighbours": { "type": "integer", "minimum": 1 },
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 },
                "average": { "type": "integer", "minimum": 1 }
              }
            },
            "perfusion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["red", "ir"],
              "properties": { "red": { "$ref": "#/definitions/key" }, "ir": { "$ref": "#/definitions/key" } }
            },
            "finger": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minDcIr", "minAcIr"],
              "properties": {
                "minDcIr": { "type": "number", "minimum": 0 },
                "minAcIr": { "type": "number", "minimum": 0 },
                "settleSeconds": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "agc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "smoothing", "high", "low", "noContact", "holdMs", "cooldownMs", "start", "min", "max", "commands"],
      "properties": {
        "input": { "$ref": "#/definitions/key" },
        "smoothing": { "type": "integer", "minimum": 1 },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "noContact": { "type": "number" },
        "holdMs": { "type": "integer", "minimum": 0 },
        "cooldownMs": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0, "maximum": 255 },
        "min": { "type": "integer", "minimum": 0, "maximum": 255 },
        "max": { "type": "integer", "minimum": 0, "maximum": 255 },
        "step": { "type": "integer", "minimum": 1 },
        "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/key" } }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames"],
      "properties": {
        "byteOrder": { "$ref": "#/definitions/byteOrder" },
        "frames": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/frame" } }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "code": { "$ref": "#/definitions/hexByte" },
        "kind": { "enum": ["data", "batchEnd", "noData", "reply"] },
        "source": { "enum": ["data", "reply"] },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maskOffset", "start", "type", "intervalMs", "keys"],
          "properties": {
            "maskOffset": { "type": "integer", "minimum": 0 },
            "start": { "type": "integer", "minimum": 0 },
            "type": { "$ref": "#/definitions/fieldType" },
            "byteOrder": { "$ref": "#/definitions/byteOrder" },
            "intervalMs": { "type": "integer", "minimum": 0 },
            "validBelow": { "type": "number" },
            "clampAbove": { "type": "number" },
            "keys": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[1-8]$" },
              "additionalProperties": { "$ref": "#/definitions/key" }
            }
          }
        },
        "reply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idOffset", "dataOffset"],
          "properties": {
            "idOffset": { "type": "integer", "minimum": 0 },
            "dataOffset": { "type": "integer", "minimum": 0 }
          }
        },
        "minLength": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/definitions/checksum" },
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "size"],
          "properties": {
            "start": { "type": "integer" },
            "end": { "type": "integer" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offset", "type", "unit"],
          "properties": {
            "offset": { "type": "integer", "minimum": 0 },
            "type": { "enum": ["uint32", "uint64"] },
            "unit": { "enum": ["s", "ms"] },
            "byteOrder": { "$ref": "#/definitions/byteOrder" }
          }
        },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/field" } },
        "events": { "$ref": "#/definitions/events" }
      },
      "if": { "properties": { "kind": { "const": "data" } } },
      "then": {
        "anyOf": [
          { "required": ["fields"], "properties": { "fields": { "minItems": 1 } } },
          { "required": ["channels"] }
        ]
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "storedAt", "accept"],
      "properties": {
        "type": { "enum": ["crc32", "xor8", "sum8"] },
        "storedAt": { "type": "integer" },
        "accept": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "integer" },
              "to": { "type": "integer" },
              "byteOrder": { "$ref": "#/definitions/byteOrder" }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "offset", "type"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "offset": { "type": "integer", "minimum": 0 },
        "type": { "$ref": "#/definitions/fieldType" },
        "scale": { "type": "number", "not": { "const": 0 } },
        "byteOrder": { "$ref": "#/definitions/byteOrder" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offset", "equals"],
          "properties": {
            "offset": { "type": "integer", "minimum": 0 },
            "equals": { "$ref": "#/definitions/hexByte" }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeOffset", "codeOffset", "types"],
      "properties": {
        "typeOffset": { "type": "integer", "minimum": 0 },
        "codeOffset": { "type": "integer", "minimum": 0 },
        "dataTypes": { "type": "array", "items": { "$ref": "#/definitions/hexByte" } },
        "types": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9A-Fa-f]{2}$" },
          "additionalProperties": { "enum": ["start", "stop", "error"] }
        }
      }
    },
    "bleSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceUuid", "notifyUuid"],
      "properties": {
        "serviceUuid": { "$ref": "#/definitions/uuid" },
        "notifyUuid": { "$ref": "#/definitions/uuid" },
        "writeUuid": { "$ref": "#/definitions/uuid" },
        "scanServiceUuid": { "$ref": "#/definitions/uuid" },
        "scanNamePrefix": { "type": "string", "minLength": 1 },
        "bond": { "type": "boolean" },
        "batteryService": { "type": "boolean" },
        "batteryPollSeconds": { "type": "integer", "minimum": 10 },
        "replyUuid": { "$ref": "#/definitions/uuid" },
        "writeWithoutResponse": { "type": "boolean" },
        "timeSync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uuid", "fields"],
          "properties": {
            "uuid": { "$ref": "#/definitions/uuid" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/timeField" }
            }
          }
        }
      }
    },
    "wifiSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "mdnsService", "stream"],
      "properties": {
        "setup": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ble", "softap"] }
        },
        "bleSetup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceUuid", "credentialsUuid", "resultUuid"],
          "properties": {
            "serviceUuid": { "$ref": "#/definitions/uuid" },
            "credentialsUuid": { "$ref": "#/definitions/uuid" },
            "resultUuid": { "$ref": "#/definitions/uuid" },
            "scanNamePrefix": { "type": "string", "minLength": 1 }
          }
        },
        "softApSetup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ssidPrefix", "address", "path"],
          "properties": {
            "ssidPrefix": { "type": "string", "minLength": 1 },
            "address": { "type": "string", "pattern": "^[0-9A-Za-z.:-]+$" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "path": { "$ref": "#/definitions/urlPath" }
          }
        },
        "mdnsService": { "type": "string", "pattern": "^_[a-z0-9-]+\\._(tcp|udp)$" },
        "stream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "enum": ["websocket", "http"] },
            "path": { "$ref": "#/definitions/urlPath" },
            "pollSeconds": { "type": "integer", "minimum": 1 },
            "commandPath": { "$ref": "#/definitions/urlPath" }
          },
          "if": { "properties": { "type": { "const": "http" } } },
          "then": { "required": ["pollSeconds"] },
          "else": { "not": { "anyOf": [{ "required": ["pollSeconds"] }, { "required": ["commandPath"] }] } }
        },
        "setupTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "urlPath": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]*$" },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "unit", "icon"],
      "properties": {
        "key": { "$ref": "#/definitions/key" },
        "label": { "type": "string", "minLength": 1 },
        "shortLabel": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "icon": {
          "enum": [
            "pulse", "drop", "heart", "thermo", "trend", "moon", "wind", "cloud",
            "dots", "gauge", "sun", "flask", "bolt", "scale", "battery",
            "play", "list", "alert", "vibrate", "ecg"
          ]
        },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
        "normal": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "goal": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "zones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "kind"],
            "properties": {
              "below": { "type": "number" },
              "label": { "type": "string", "minLength": 1 },
              "kind": { "$ref": "#/definitions/statusKind" }
            }
          }
        },
        "states": {
          "type": "object",
          "propertyNames": { "pattern": "^-?[0-9]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "kind"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "kind": { "$ref": "#/definitions/statusKind" }
            }
          }
        },
        "pair": { "$ref": "#/definitions/key" },
        "format": { "enum": ["number", "hoursMinutes"] },
