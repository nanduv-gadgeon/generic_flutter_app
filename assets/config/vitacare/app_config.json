{
  "isCloud": false,
  "brand": {
    "appName": "VitaCare",
    "logoMark": "assets/brand/vitacare/logo_mark.svg",
    "logoSplash": "assets/brand/vitacare/logo_splash.svg",
    "initials": "V",
    "tagline": "Care that stays connected"
  },
  "theme": {
    "primary": "#0F766E",
    "accent": "#2DD4BF",
    "font": "Nunito",
    "cornerRadius": 22,
    "cornerRadiusSmall": 16,
    "mode": "system"
  },
  "features": {
    "registration": true,
    "faceIdLogin": true,
    "history": true,
    "export": true,
    "alerts": true
  },
  "links": {
    "privacyPolicy": "https://example.com/privacy",
    "termsOfUse": "https://example.com/terms"
  },
  "history": { "daysOnPhone": 7 },
  "cloud": {
    "baseUrl": "https://api.example",
    "environment": "dev",
    "uploader": "flutterModule",
    "autoSyncDefault": "15m"
  },
  "deviceTypes": ["smart_band_v1", "env_sensor_v1", "wearable_patch_v1", "health_kit_v1"],
  "deviceProfiles": []
}
