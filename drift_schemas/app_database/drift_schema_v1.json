  "fixed_sql": [
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"email\" TEXT NOT NULL UNIQUE, \"mobile\" TEXT NOT NULL, \"password_hash\" BLOB NOT NULL, \"password_salt\" BLOB NOT NULL, \"hash_params\" TEXT NOT NULL, \"failed_login_count\" INTEGER NOT NULL DEFAULT 0, \"locked_until\" INTEGER NULL, \"biometric_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"biometric_enabled\" IN (0, 1)), \"photo_path\" TEXT NULL, \"terms_accepted_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"user_id\" INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE, \"started_at\" INTEGER NOT NULL, \"last_active_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"user_id\" INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"profile_id\" TEXT NOT NULL, \"transport\" TEXT NOT NULL, \"address\" TEXT NOT NULL, \"firmware\" TEXT NULL, \"battery_percent\" INTEGER NULL CHECK(\"battery_percent\" BETWEEN 0 AND 100), \"last_heartbeat_at\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL, \"device_key\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"user_id\", \"address\"));"
        }
      ]
    },
    {
      "name": "devices_user_order",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX devices_user_order ON devices (user_id, sort_order)"
        }
      ]
    }
  ]
