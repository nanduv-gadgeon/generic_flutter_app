    {
      "id": "ief_device_v1",
      "label": "Therapy device",
      "summary": "Event log (START / STOP / DATA / ERROR), battery, versions, sync status",
      "icon": "bolt",
      "transports": ["ble"],
      "readings": [
        { "key": "current", "label": "Current", "unit": "mA", "icon": "bolt", "decimals": 1, "normal": [8, 16], "scale": [0, 25] },
        { "key": "run_time", "label": "Run time", "unit": "h", "icon": "play", "decimals": 1, "source": "eventsRunTimeToday" },
        { "key": "sessions", "label": "Sessions", "unit": "", "icon": "list", "source": "eventsSessionsToday" },
        { "key": "errors", "label": "Errors", "unit": "", "icon": "alert", "normal": [0, 0], "scale": [0, 5], "source": "eventsErrorsToday" }
      ],
      "quickReadings": ["current"],
      "alerts": [{ "key": "battery", "below": 15 }],
      "ble": {
        "serviceUuid": "1257dd10-6f99-498f-b4a6-04dc1e3591f6",
        "writeUuid": "1257dd11-6f99-498f-b4a6-04dc1e3591f6",
        "notifyUuid": "1257dd12-6f99-498f-b4a6-04dc1e3591f6",
        "scanServiceUuid": "00001257-dd10-6f99-498f-b4a604dc91f6",
        "bond": true,
        "batteryService": true
      },
      "packet": {
        "byteOrder": "little",
        "frames": [
          {
            "code": "90",
            "kind": "data",
            "minLength": 6,
            "checksum": {
              "type": "crc32",
              "storedAt": -4,
              "accept": [
                { "from": 2, "to": -4, "byteOrder": "little" },
                { "from": 0, "to": -4, "byteOrder": "little" },
                { "from": 2, "to": -4, "byteOrder": "big" }
              ]
            },
            "records": { "start": 2, "end": -4, "size": 12 },
            "time": { "offset": 0, "type": "uint64", "unit": "s" },
            "fields": [
              { "key": "battery", "offset": 9, "type": "uint8" },
              { "key": "current", "offset": 10, "type": "uint8", "when": { "offset": 8, "equals": "03" } },
              { "key": "current", "offset": 11, "type": "uint8", "scale": 0.01, "when": { "offset": 8, "equals": "03" } }
            ],
            "events": {
              "typeOffset": 8,
              "codeOffset": 10,
              "dataTypes": ["03"],
              "types": { "01": "start", "02": "stop", "04": "error" }
            }
          },
          { "code": "91", "kind": "batchEnd" },
          { "code": "92", "kind": "noData" }
        ]
      },
      "commands": [
        {
          "id": "set_clock",
          "bytes": "81 09",
          "time": ["second", "minute", "hour12", "day", "month", "year2", "weekdayMon1", "pm", "zero"]
        },
        { "id": "request_logs", "bytes": "82 00" }
      ],
      "sync": {
        "onConnect": ["set_clock", "request_logs"],
        "idleTimeoutMs": 30000,
        "everySeconds": 60,
        "repeat": ["request_logs"]
      },
      "heartbeat": { "intervalSeconds": 60, "offlineAfterMissed": 3 },
      "dashboard": {
        "strip": "state",
        "syncNow": {
          "label": "Sync now",
          "command": "request_logs",
          "done": "Fetching the readings stored on the device."
        }
      }
    },
    {
